# Streamlit Secrets Configuration
# Copy this file to your Streamlit Cloud app settings under "Secrets"
# Go to: https://share.streamlit.io/ → Your App → Settings → Secrets

# Flask API URL for AI explanations (Railway deployment)
# Replace with your actual Railway URL after deployment
FLASK_API_URL = "https://your-app-name.up.railway.app"

# For local development, this file is not needed - the code defaults to localhost:8502
# Only needed for Streamlit Cloud deployment
