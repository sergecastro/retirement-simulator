# utils/local_storage_simple.py - File-based persistent storage (PRIVACY-FIRST!)
"""
Privacy-first persistent storage using encrypted local files.

WHY THIS IS BETTER THAN localStorage/cookies:
- No browser size limits (localStorage limited to ~5MB)
- Works in ALL browsers reliably
- Data encrypted on disk
- Privacy-first: Data never sent to browser JavaScript
- Session-based: Each browser gets unique ID, data cleared when they close browser

ARCHITECTURE:
- User opens app → Gets unique session_id in st.session_state
- Save → Encrypts data and saves to .family_forecast_data/{session_id}.enc
- Load → Reads encrypted file and decrypts
- Browser close → session_id lost, file remains but inaccessible (cleanup job can delete old files)
"""

import streamlit as st
import json
import os
from pathlib import Path
from typing import Dict, Any, Optional
from utils.encryption import encrypt_data, decrypt_data
import secrets

# Data directory
DATA_DIR = Path(".family_forecast_data")
DATA_DIR.mkdir(exist_ok=True)


def get_session_id() -> str:
    """
    Get or create a unique session ID for this browser (persists across sessions).

    Stores session_id in a cookie so it survives browser close.
    Only the ID is stored in the cookie, actual data stays encrypted on server.

    Returns:
        Session ID (unique per browser)
    """
    # Check if already in session_state (fast path)
    if 'storage_session_id' in st.session_state:
        return st.session_state.storage_session_id

    # Try to get from cookie
    try:
        import extra_streamlit_components as stx
        cookie_manager = stx.CookieManager()
        cookies = cookie_manager.get_all()

        if cookies and 'ff_session_id' in cookies:
            # Found existing session ID in cookie
            session_id = cookies['ff_session_id']
            st.session_state.storage_session_id = session_id
            print(f"[INFO] Restored session_id from cookie: {session_id[:8]}...")
            return session_id
    except Exception as e:
        print(f"[WARN] Could not load session_id from cookie: {e}")

    # Generate new session ID
    session_id = secrets.token_urlsafe(16)
    st.session_state.storage_session_id = session_id

    # Save to cookie for persistence (1 year expiration)
    try:
        import extra_streamlit_components as stx
        cookie_manager = stx.CookieManager()
        cookie_manager.set(
            cookie='ff_session_id',
            val=session_id,
            max_age=31536000,  # 1 year
            path='/',
            same_site='lax',
            key='set_session_id'
        )
        print(f"[INFO] Created new session_id and saved to cookie: {session_id[:8]}...")
    except Exception as e:
        print(f"[WARN] Could not save session_id to cookie: {e}")

    return session_id


def save_to_local_storage_encrypted(key: str, data: Dict[str, Any]) -> bool:
    """
    Save ENCRYPTED data to local file storage.

    Args:
        key: Storage key (e.g., 'snapshot_index')
        data: Dictionary to encrypt and save

    Returns:
        True if successful
    """
    try:
        session_id = get_session_id()

        # Encrypt the data
        encrypted_string = encrypt_data(data)

        # Save to file: .family_forecast_data/{session_id}_{key}.enc
        file_path = DATA_DIR / f"{session_id}_{key}.enc"
        file_path.write_text(encrypted_string, encoding='utf-8')

        print(f"[OK] Saved to file: {file_path.name}")
        return True

    except Exception as e:
        print(f"[ERROR] Failed to save: {e}")
        import traceback
        traceback.print_exc()
        return False


def load_from_local_storage_encrypted(key: str) -> Optional[Dict[str, Any]]:
    """
    Load and DECRYPT data from local file storage.

    Args:
        key: Storage key (e.g., 'snapshot_index')

    Returns:
        Decrypted dictionary, or None if not found
    """
    try:
        session_id = get_session_id()

        # Read from file: .family_forecast_data/{session_id}_{key}.enc
        file_path = DATA_DIR / f"{session_id}_{key}.enc"

        if not file_path.exists():
            print(f"[INFO] No file found: {file_path.name}")
            return None

        encrypted_string = file_path.read_text(encoding='utf-8')

        # Decrypt the data
        decrypted_data = decrypt_data(encrypted_string)

        if decrypted_data:
            print(f"[OK] Loaded from file: {file_path.name}")
            return decrypted_data
        else:
            print(f"[WARN] Decryption failed for: {file_path.name}")
            return None

    except Exception as e:
        print(f"[ERROR] Failed to load: {e}")
        import traceback
        traceback.print_exc()
        return None


def delete_from_local_storage(key: str) -> bool:
    """
    Delete data from local file storage.

    Args:
        key: Storage key to delete

    Returns:
        True if successful
    """
    try:
        session_id = get_session_id()
        file_path = DATA_DIR / f"{session_id}_{key}.enc"

        if file_path.exists():
            file_path.unlink()
            print(f"[OK] Deleted file: {file_path.name}")
        else:
            print(f"[INFO] File not found: {file_path.name}")

        return True

    except Exception as e:
        print(f"[ERROR] Failed to delete: {e}")
        return False
